# ========================
# 寰宇智杭 环境配置
# ========================

# --- 数据库 ---
DATABASE_URL=sqlite+aiosqlite:///./yuhang_space.db

# --- JWT 认证 ---
JWT_SECRET_KEY=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- 大模型配置（OpenAI 兼容协议） ---
LLM_ENABLED=true
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# --- 运维 API ---
MAINTENANCE_API_KEY=CHANGE_ME_TO_RANDOM_STRING
MAINTENANCE_ALLOWED_IPS=127.0.0.1

# --- 媒体存储 ---
MEDIA_ROOT=./media
MAX_UPLOAD_SIZE_MB=50
ALLOWED_IMAGE_TYPES=jpg,jpeg,png,gif,webp
ALLOWED_VIDEO_TYPES=mp4,mov,avi,webm

# --- 服务器 ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
DEBUG=true

# --- 前端 ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
